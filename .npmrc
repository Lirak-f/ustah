# This monorepo runs two React majors: the Medusa backend/admin dashboard needs
# React 18, the Next.js storefront needs React 19.
#
# npm hoists a single copy of each package to the root regardless of which
# workspace declared it, so @radix-ui/*, @headlessui/react and
# react-country-flag resolved React 18 while the storefront compiled against
# React 19 — every element they created was rejected at render time with
# "Objects are not valid as a React child" (React error #31 at build).
# npm's install-strategy=nested did NOT prevent that hoisting.
#
# pnpm resolves peer dependencies per dependent, so the storefront and the
# backend each get their own copy of a shared React-consuming package, linked
# against their own React. That is why this repo is on pnpm.

# Medusa's dependency tree reports a large number of peer mismatches that are
# not actionable here; do not fail the install on them.
strict-peer-dependencies=false
auto-install-peers=true
