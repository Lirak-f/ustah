# This monorepo runs two React majors: the Medusa backend/admin dashboard needs
# React 18, the Next.js storefront needs React 19. npm hoists one copy to the
# root, and whichever it picks, the other workspace breaks — for the storefront
# that means Next rendering with a different React than the app compiles
# against (React error #31 at build time).
#
# nested keeps every workspace's dependencies inside its own node_modules, so
# each resolves its own React. Slower installs, correct builds.
install-strategy=nested
