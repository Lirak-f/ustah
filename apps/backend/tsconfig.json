{
  "compilerOptions": {
    "target": "ES2021",
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "./",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "strictNullChecks": true,

    /*
     * Admin extensions under src/admin are React 18 (Medusa's dashboard
     * requirement) while the storefront workspace is React 19, so both
     * @types/react versions are installed. This program includes src/admin,
     * and without pinning, its .tsx files resolve the React 19 types hoisted
     * at the repo root — making every @medusajs/ui component fail as "cannot
     * be used as a JSX component". Same version split AGENTS.md documents for
     * the runtime, surfacing in the type layer.
     */
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"]
    }
  },
  "ts-node": {
    "swc": true
  },
  "include": ["**/*", ".medusa/types/*"],
  "exclude": [
    "node_modules",
    ".medusa/server",
    ".medusa/admin",
    ".cache",
    "eslint.config.*"
  ]
}
